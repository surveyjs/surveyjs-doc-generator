{
  "name": "surveyjs-doc-generator",
  "version": "0.4.0",
  "main": "index.js",
  "typings": "index",
  "typescript": {
    "definition": "index"
  },
  "dependencies": {
    "ts-node": "^8.1.0",
    "typescript": "4.2.4"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.readdirSync('src').filter(f=>f.endsWith('.js')||f.endsWith('.js.map')).forEach(f=>fs.unlinkSync('src/'+f))\"",
    "build": "npm run clean && tsc index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
